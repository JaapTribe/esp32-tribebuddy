# Settings for feeder.py. Copy this file to .env (same folder) and fill in what you use;
# .env is git-ignored. These win over the same variables set in your shell. After changing it, restart
# the feeder, or run `python3 feeder.py install-service` again for the service.

# Webhook / ngrok tunnel
#TRIBEBUDDY_WEBHOOK_TOKEN=
#TRIBEBUDDY_TUNNEL=ngrok
#TRIBEBUDDY_TUNNEL_DOMAIN=your-domain.ngrok-free.dev

# Bitbucket Pipelines
#TRIBEBUDDY_BITBUCKET_WORKSPACE=
#TRIBEBUDDY_BITBUCKET_EMAIL=you@company.com
#TRIBEBUDDY_BITBUCKET_TOKEN=

# 3D printer (Bambu Lab)
#TRIBEBUDDY_PRINTER_HOST=192.168.1.50
#TRIBEBUDDY_PRINTER_SERIAL=
#TRIBEBUDDY_PRINTER_CODE=
#TRIBEBUDDY_PRINTER_NAME=Bambu P1S

# Jira (the e-mail falls back to TRIBEBUDDY_BITBUCKET_EMAIL)
#TRIBEBUDDY_JIRA_SITE=tribeagency.atlassian.net
#TRIBEBUDDY_JIRA_EMAIL=you@company.com
#TRIBEBUDDY_JIRA_TOKEN=
#TRIBEBUDDY_JIRA_JQL="assignee = currentUser() AND statusCategory != Done ORDER BY priority"

# Calendar: secret iCal (ICS) address(es), comma-separated; notification minutes before (0 = off)
#TRIBEBUDDY_CALENDAR_ICS=https://calendar.google.com/calendar/ical/.../basic.ics
#TRIBEBUDDY_CALENDAR_NOTIFY=5
#TRIBEBUDDY_CALENDAR_EMAIL=you@company.com

# Allow/deny Claude Code permission requests on the display (also: feeder.py install-hooks --approve)
#TRIBEBUDDY_APPROVE=1

# Display settings; leave out to control them from the display's Settings page
#TRIBEBUDDY_BRIGHTNESS=60
#TRIBEBUDDY_APPS=dev,printer,jira,calendar
#TRIBEBUDDY_CONTRAST=high
